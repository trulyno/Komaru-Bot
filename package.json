{
    "name": "komaru-bot",
    "version": "0.1.0",
    "description": "Base for the Komaru the Cat Discord application",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "lint": "node scripts/lint.js .",
        "format": "prettier --write .",
        "lint:typecheck": "tsc -p tsconfig.json",
        "test": "ts-node tests/runTests.ts",
        "deploy": "ts-node scripts/deploy.ts",
        "deploy:dry-run": "ts-node scripts/deploy.ts --dry-run"
    },
    "keywords": [
        "discord",
        "bot",
        "typescript",
        "komaru"
    ],
    "author": "trulyno",
    "license": "MIT",
    "type": "commonjs",
    "dependencies": {
        "chess.js": "^1.4.0",
        "discord.js": "^14.16.2",
        "dotenv": "^17.4.2",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "@typescript-eslint/eslint-plugin": "^8.63.0",
        "@typescript-eslint/parser": "^8.63.0",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "prettier": "^3.9.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.5"
    }
}
