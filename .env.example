# General configs
DISCORD_TOKEN=
DISCORD_GUILD_ID=
LOG_LEVEL=info
BOT_OWNER_ID=

# Moderation & Audit log configs
MODERATION_MODERATOR_ROLE_NAME=Moderator
MODERATION_MODERATOR_ROLE_ID=
MODERATION_ADMIN_ROLE_NAME=Administrator
MODERATION_ADMIN_ROLE_ID=
MODERATION_AUDIT_CHANNEL_ID=

# Verification configs
VERIFICATION_CHANNEL_ID=
VERIFICATION_CHANNELS_ALLOWED=screenshots,panoramas
VERIFIER_ROLE_ID=
VERIFIER_ROLE_NAME=verifier
LEGACY_CSG_ROLE_ID=
ASG_ROLE_ID=
DSG_ROLE_ID=

# Template detection configs
ISSUE_REPORTING_CHANNEL_ID=
SUGGESTIONS_CHANNEL_ID=
TEMPLATE_INVALID_TAGS=invalid,needs template,template missing

# Ticket system configs
TICKET_INACTIVITY_HOURS=24
TICKET_CATEGORY_ID=
TICKET_CATEGORY_NAME=Tickets

# Google Drive & Backup System configs
# Authentication: provide GOOGLE_SERVICE_ACCOUNT_KEY_PATH (e.g. ./service-account.json)
# OR GOOGLE_SERVICE_ACCOUNT_JSON (raw JSON string)
# OR GOOGLE_SERVICE_ACCOUNT_EMAIL and GOOGLE_PRIVATE_KEY
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Google Drive Folder ID to store backups (create a folder in Drive and share with service account email)
GOOGLE_DRIVE_FOLDER_ID=
# Backup frequency in minutes (default: 360 = 6 hours)
BACKUP_INTERVAL_MINUTES=360
# Number of backups to keep in Google Drive before deleting oldest (default: 10)
BACKUP_RETENTION_COUNT=10
# Set to false to disable automatic scheduled backups
BACKUP_ENABLED=true